{
  "name": "gifselector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server/server.ts",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch src/server/server.ts",
    "dev:client": "vite",
    "start": "node src/server/server.ts",
    "build": "vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p e2e/tsconfig.json",
    "test:server": "node --test 'test/server/**/*.test.ts' 'test/discord/**/*.test.ts'",
    "test:client": "vitest run",
    "test": "pnpm test:server && pnpm test:client",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "discord.js": "14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nanoid": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.17.0"
}
